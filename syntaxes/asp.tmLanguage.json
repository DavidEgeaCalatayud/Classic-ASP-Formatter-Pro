{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Classic ASP",
  "scopeName": "text.html.asp",
  "patterns": [
    {
      "include": "#asp"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "asp": {
      "patterns": [
        {
          "name": "meta.directive.asp",
          "begin": "<%@",
          "end": "%>",
          "patterns": [
            {
              "name": "keyword.other.directive.asp",
              "match": "\\b(LANGUAGE|CODEPAGE|LCID|ENABLESESSIONSTATE|TRANSACTION)\\b"
            },
            {
              "name": "string.quoted.double.asp",
              "begin": "\"",
              "end": "\""
            }
          ]
        },
        {
          "name": "comment.block.include.asp",
          "match": "<!--#include\\s+(file|virtual)=\\\"[^\\\"]+\\\"\\s*-->"
        },
        {
          "name": "meta.output-expression.asp",
          "begin": "<%=",
          "end": "%>",
          "patterns": [
            {
              "include": "source.vbnet"
            }
          ]
        },
        {
          "name": "source.asp.embedded.html",
          "begin": "<%",
          "end": "%>",
          "patterns": [
            {
              "include": "source.vbnet"
            }
          ]
        }
      ]
    }
  }
}
